<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- محتوى الشاشات الخمس -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. شاشة القرعة والسحب -->
        <ScrollView
            android:id="@+id/tabRoulette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- شريط القسم والحصة -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectClass"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="اختر القسم ▼" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNewSession"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="حصة جديدة"
                                android:textColor="@color/accent_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSessionInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="لا يوجد قسم محدد"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- بطاقة القرعة المركزية -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRoulette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/accent_primary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="170dp"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/bonus_gold"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSelectedStudent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="اضغط للبدء في السحب العشوائي"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnswerTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text=""
                            android:textColor="@color/accent_primary"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- أزرار السحب -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartDraw"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="2"
                        android:text="ابدأ السحب العشوائي"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickSpin"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="سحب فوري" />
                </LinearLayout>

                <!-- لوحة التقييم الفوري (تظهر بعد اختيار التلميذ) -->
                <LinearLayout
                    android:id="@+id/layoutEvaluation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@color/surface_dark"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="العلامة"
                            android:inputType="numberDecimal"
                            android:text="10"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBonus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="+ تشجيع"
                            android:textColor="@color/bonus_gold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="المادة (اختياري)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBehavior"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="ملاحظة سريعة (اختياري)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkAnswered"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/status_answered"
                            android:text="أجاب" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkMissed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/status_missed"
                            android:text="لم يجب" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkAbsent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/status_absent"
                            android:text="غائب" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 2. شاشة إدارة الأقسام والتلاميذ -->
        <LinearLayout
            android:id="@+id/tabClasses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddClass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+ قسم" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRenameClass"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="تعديل" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteClass"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="حذف"
                    android:textColor="@color/status_absent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddStudent"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+ تلميذ" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportExcel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Excel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasteList"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="لصق" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeedDemo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="تجريبي" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearchStudent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="بحث عن تلميذ..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 3. شاشة سجل الإجابات -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportRecords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تصدير السجل Excel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportGrades"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="كشف النقاط" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSearchHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="ابحث بالاسم أو التاريخ أو الحالة..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 4. شاشة الإحصائيات والمجموعات -->
        <ScrollView
            android:id="@+id/tabAnalytics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCoverageSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تغطية القسم: 0%"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressCoverage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvFairnessInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/accent_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTopPerformers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@color/surface_dark"
                    android:padding="12dp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvLeastParticipated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/surface_dark"
                    android:padding="12dp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="مولد المجموعات العشوائية:"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etGroupSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="عدد التلاميذ بالمجموعة"
                        android:inputType="number"
                        android:text="4"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateGroups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="تقسيم الفرق" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGroupsResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </ScrollView>

        <!-- 5. شاشة الإعدادات ومركز التشخيص -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAllowRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="السماح بتكرار التلميذ في نفس الدورة"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSoundEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفعيل المؤثرات الصوتية"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swTtsEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نطق اسم التلميذ صوتياً"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAnswerTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفعيل مؤقت الإجابة التنازلي"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swShowBehavior"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إظهار بطاقات السلوك السريع"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swShowSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفعيل التقييم حسب المادة"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSafeDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضع العرض الآمن (إخفاء الدرجات)"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swKeepScreenOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="منع قفل الشاشة أثناء الحصة"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCountdownSec"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="العد (ث)"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />

                    <EditText
                        android:id="@+id/etMaxScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="السلم (20)"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />

                    <EditText
                        android:id="@+id/etBonusValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="التشجيع (+)"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveNumericSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حفظ" />
                </LinearLayout>

                <!-- تبديل المظهر -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeDark"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ليلي" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeLight"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="نهاري" />
                </LinearLayout>

                <!-- النسخ الاحتياطي والتشخيص -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackupExport"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="تصدير نسخة احتياطية (JSON)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackupImport"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="استرجاع نسخة احتياطية" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHealthCheck"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="فحص سلامة قاعدة البيانات" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewErrorLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/error_red"
                    android:text="سجل تتبع الأخطاء (Debug Log)" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- شريط التنقل السفلي -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:itemIconTint="@color/accent_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
